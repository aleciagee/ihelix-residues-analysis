# Define your groups
king_groups <- c("Bacillati", "Pseudomonadati", "Fungi", "Metazoa", "Viridiplantae", "Other")

# Define your custom colors
colours <- c("#d73027", "#fc8d59", "#fee090", 
             "#e0f3f8", "#91bfdb", "#4575b4")

