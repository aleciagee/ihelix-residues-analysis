library(tidyverse)
library(cowplot)
library(ggpubr)
library(RColorBrewer)
acidalc <- read_csv("~/PhD/Experimental/Project 2/R_DataVisualisation/acid_alcohol.csv")
acidalc
# Define your groups
king_groups <- c("Bacillati", "Pseudomonadati", "Fungi", "Metazoa", "Viridiplantae", "Other")
# Define your custom colors
colours <- c("#d73027", "#fc8d59", "#fee090",
"#e0f3f8", "#91bfdb", "#4575b4")
# Name them according to the groups
names(colours) <- king_groups
# Set factor levels for the main data (if needed elsewhere)
acidalc$king_cond <- factor(acidalc$king_cond, levels = king_groups)
acidalcie <- acidalc %>%
ggplot(aes(y = reorder(acid_alc, total_count), x = percentage, fill = king_cond)) +
geom_col(width = 0.5) +
ylab(NULL) +
xlab(NULL) +
theme(
panel.grid.major.x = element_line(colour = "lightgrey", linetype = "dashed"),
panel.background = element_rect(fill = "white", colour = NA),
axis.ticks.y = element_blank(),
axis.ticks.x = element_line(colour = "lightgrey"),
legend.position = "bottom",
legend.title = element_blank(),
axis.text.x = element_text(size = 8, colour = "black"),
