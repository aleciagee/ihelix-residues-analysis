panel.grid.major.x = element_line(colour = "lightgrey", linetype = "solid", size = 0.3),
panel.background = element_rect(fill = "white", colour = NA),
axis.ticks.y = element_blank(),
axis.ticks.x = element_blank(),
axis.text.x = element_text(size = 8, colour = "black"),
axis.text.y = element_text(size = 8, colour = "black")
) +
scale_y_discrete(expand = c(0, 0)) +
scale_x_continuous(expand = c(0.01, 0)) +
guides(fill = guide_legend(nrow = 1)) +
theme(legend.position = "none") +
scale_fill_manual(values = colours)
# Number of rows (unique bars)
n_bars <- length(unique(df$acid_alc))
# Scale height: e.g., 0.3 inches per bar
plot_height <- n_bars * 0.3
ggsave(filename = paste0(pos1, "_", pos2, ".png"),
plot = p,
width = 5,
height = plot_height,
dpi = 600)
} else {
warning(paste("File not found:", file_name))
}
}
View(grouped_data)
grouped_data_allkingdoms <- unique_kingdoms %>%
group_by(acid_alc, kingdom) %>%
summarise(group_count = n(), .groups = "drop_last") %>%
mutate(
total_count = sum(group_count),
percentage = (group_count / total_count) * 100
) %>%
arrange(acid_alc, kingdom) %>%
separate(acid_alc, into = c("acid", "alc"), sep = 1, remove = FALSE)
grouped_data_allkingdoms <- cleaned_data %>%
group_by(acid_alc, kingdom) %>%
summarise(group_count = n(), .groups = "drop_last") %>%
mutate(
total_count = sum(group_count),
percentage = (group_count / total_count) * 100
) %>%
arrange(acid_alc, kingdom) %>%
separate(acid_alc, into = c("acid", "alc"), sep = 1, remove = FALSE)
grouped_data_allkingdoms
